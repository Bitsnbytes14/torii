# TEMPLATE ONLY — never fill this in and commit it.
#
# The .example extension keeps `kubectl apply -f deploy/k8s/` from applying
# it (kubectl only reads .yaml/.yml/.json), so a stray apply can't overwrite
# the real Secret with these placeholders.
#
# Create the real Secrets directly with kubectl instead (see README):
#
#   kubectl -n torii create secret generic torii-secrets \
#     --from-literal=POSTGRES_PASSWORD="$PG_PASSWORD" \
#     --from-literal=DATABASE_URL="postgres://torii:$PG_PASSWORD@postgres:5432/torii?sslmode=disable" \
#     --from-literal=JWT_SECRET="$(openssl rand -hex 32)" \
#     --from-literal=CONTROLPLANE_ADMIN_TOKEN="$(openssl rand -hex 32)"
#
#   kubectl -n torii create secret docker-registry ghcr-pull \
#     --docker-server=ghcr.io \
#     --docker-username=<github-username> \
#     --docker-password=<PAT with read:packages only>
#
# This file documents the shape the manifests expect.
apiVersion: v1
kind: Secret
metadata:
  name: torii-secrets
  namespace: torii
type: Opaque
stringData:
  POSTGRES_PASSWORD: "<postgres password>"
  # Must embed the same password as POSTGRES_PASSWORD.
  DATABASE_URL: "postgres://torii:<postgres password>@postgres:5432/torii?sslmode=disable"
  JWT_SECRET: "<random, e.g. openssl rand -hex 32>"
  CONTROLPLANE_ADMIN_TOKEN: "<random, e.g. openssl rand -hex 32>"
---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
  namespace: torii
type: kubernetes.io/dockerconfigjson
data:
  # base64 of {"auths":{"ghcr.io":{"auth":"<base64 of username:PAT>"}}}
  .dockerconfigjson: "<base64 docker config>"
