# Copy to .env (or export manually) for local runs outside Docker.
# `docker compose up` sets its own equivalents and doesn't need this file.

# booking service
DATABASE_URL=postgres://torii:torii@localhost:5432/torii?sslmode=disable
PORT=8083

# gateway (run twice with PORT=8080 and PORT=8081 for two replicas)
BOOKING_SERVICE_URL=http://localhost:8083
JWT_SECRET=dev-secret-change-me
WEB_DIR=./web
REDIS_URL=redis://localhost:6379/0
# How long each gateway trusts its cached tenant config; also the upper
# bound on how long a control-plane change takes to reach every replica.
TENANT_CACHE_TTL=5s

# controlplane (refuses to start without an admin token; compose uses
# dev-admin-token unless you override it)
# PORT=8082
# REDIS_URL=redis://localhost:6379/0
CONTROLPLANE_ADMIN_TOKEN=dev-admin-token

# used by internal/booking's concurrency test (go test ./internal/booking/...)
TEST_DATABASE_URL=postgres://torii:torii@localhost:5432/torii?sslmode=disable
# optional: run Redis-backed tests against a real Redis instead of miniredis
# TEST_REDIS_URL=redis://localhost:6379/0
