meta {
  name: 6 - Create Booking (Success)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/bookings
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
  Authorization: Bearer {{devToken}}
}

body:json {
  {
    "event_id": "{{eventId}}",
    "holder": "{{holder}}",
    "seats": 1
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("bookingId", res.body.id);
}
