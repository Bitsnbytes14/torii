meta {
  name: 5 - Get Dev Token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/dev-token
  body: json
  auth: none
}

body:json {
  {
    "holder": "bruno-tester"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("devToken", res.body.token);
  bru.setVar("holder", "bruno-tester");
}
