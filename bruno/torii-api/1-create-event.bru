meta {
  name: 1 - Create Event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/events
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Demo Event",
    "starts_at": "2026-12-01T18:00:00Z",
    "total_seats": 1
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("eventId", res.body.id);
}
